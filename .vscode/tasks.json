            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": true,
                "clear": false
            }
        },
        {
            "label": "Format Code (clang-format)",
            "type": "shell",
            "command": "find",
            "args": [
                ".",
                "-name",
                "*.c",
                "-o",
                "-name",
                "*.h",
                "-o",
                "-name",
                "*.cpp",
                "-o",
                "-name",
                "*.hpp",
                "|",
                "grep",
                "-v",
                "Drivers/",
                "|",
                "grep",
                "-v",
                "Middlewares/Third_Party/",
                "|",
                "xargs",
                "clang-format",
                "-i",
                "--style=file"
            ],
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": true,
                "clear": false
            },
            "options": {
                "cwd": "${workspaceFolder}"
            }
        },
        {
            "label": "Static Analysis (cppcheck)",
            "type": "shell",
            "command": "cppcheck",
            "args": [
                "--enable=all",
                "--inconclusive",
                "--std=c11",
                "--platform=unix32",
                "--suppress=missingIncludeSystem",
                "--suppress=unusedFunction",
                "--suppress=unmatchedSuppression",
                "-I",
                "Drivers/CMSIS/Device/ST/STM32H7xx/Include",
                "-I",
                "Drivers/CMSIS/Include",
                "-I",
                "Drivers/STM32H7xx_HAL_Driver/Inc",
                "-I",
                "CM7/Core/Inc",
                "-I",
                "CM4/Core/Inc",
                "-I",
                "Common/Inc",
                "CM7/",
                "CM4/",
                "Common/"
            ],
            "group": "test",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": true,
                "clear": false
            },
            "problemMatcher": {
                "owner": "cppcheck",
                "fileLocation": [
                    "relative",
                    "${workspaceFolder}"
                ],
                "pattern": {
                    "regexp": "^\\[(.*):(\\d+)\\]:\\s+\\((\\w+)\\)\\s+(.*)$",
                    "file": 1,
                    "line": 2,
                    "severity": 3,
                    "message": 4
                }
            },
            "options": {
                "cwd": "${workspaceFolder}"
            }
        }
    ]
}
